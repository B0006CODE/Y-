PORT=3001
JWT_SECRET=replace-with-strong-secret
# 允许多个来源，用逗号分隔；生产建议填写你的域名（含协议），例如：https://example.com
CORS_ORIGIN=http://localhost:4000

# ===== MySQL 5.7（必填）=====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=ancient_love_game
MYSQL_USER=alg_user
MYSQL_PASSWORD=replace-with-strong-password
# MYSQL_CONNECTION_LIMIT=10

# ===== LLM 代理（可选）=====
# 你的项目“不提供大模型 Key”，推荐让用户自己在前端填写 API Key。
# 为了解决浏览器 CORS 限制，你可以让前端请求本服务的 /api/v1/chat/completions，
# 本服务会把用户请求中的 Authorization 透传到上游（不会保存 Key）。
# 注意：上游地址由 LLM_BASE_URL 决定，用户侧填写的 API 地址应为你的同域代理地址（例如：https://your-domain.com/api/v1）。
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 如果你想由服务端统一提供 Key，再启用下面这一项（否则保持注释/留空）
# LLM_API_KEY=replace-with-your-api-key
# 是否要求登录后才能调用 LLM 代理（生产建议 true）
# LLM_REQUIRE_AUTH=true
